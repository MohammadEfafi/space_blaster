# فایل‌های کش و بایت‌کد پایتون
# Python cache and compiled bytecode files
__pycache__/
*.py[cod]
*$py.class

# انواع فایل‌های بایت‌کد پایتون
# Python bytecode file formats
*.pyc
*.pyo

# محیط‌های مجازی و تنظیمات نسخه پایتون
# Virtual environments and Python version configuration
.venv/
venv/
env/
ENV/
.conda/
.python-version

# فایل‌ها و پوشه‌های تولیدشده هنگام ساخت و بسته‌بندی پروژه
# Files and directories generated during building and packaging
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/
pip-wheel-metadata/
MANIFEST
*.manifest

# فایل‌های تنظیمات و خروجی بسته‌بندی اجرایی
# Executable packaging configuration and output files
*.spec
*.exe
*.app
*.dmg
*.msi

# کش ابزارهای تست، بررسی کد و پوشش تست
# Caches and generated files from testing, linting, and coverage tools
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.coverage
.coverage.*
htmlcov/
*.cover
.hypothesis/

# تنظیمات محیط توسعه VS Code
# VS Code workspace settings
.vscode/
!.vscode/settings.json
!.vscode/extensions.json

# تنظیمات محیط‌های توسعه PyCharm و IntelliJ
# PyCharm and IntelliJ workspace settings
.idea/
*.iml

# فایل‌های پروژه و تنظیمات ویرایشگر Sublime Text
# Sublime Text project and workspace files
*.sublime-project
*.sublime-workspace

# فایل‌های موقت و پشتیبان ویرایشگر Vim
# Vim temporary and backup files
*.swp
*.swo
*~

# فایل‌های موقت و پیکربندی ویرایشگر Emacs
# Emacs temporary and configuration files
*~
\#*\#
.\#*

# فایل‌های سیستمی و مخفی ویندوز
# Windows system and hidden files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini

# فایل‌های سیستمی macOS
# macOS system files
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# فایل‌ها و تنظیمات سیستمی Linux
# Linux system and configuration files
.directory
*~

# فایل‌های ذخیره‌سازی محلی؛ فقط فایل نگهدارنده پوشه در Git باقی می‌ماند
# Local save files; only the directory placeholder is tracked by Git
saves/*
!saves/.gitkeep

# فایل‌های گزارش، موقت و کش برنامه
# Application log, temporary, and cache files
*.log
logs/
*.tmp
*.temp
.cache/

# فایل‌های حاوی متغیرهای محیطی، کلیدها و اطلاعات محرمانه
# Environment variable files, keys, and sensitive credentials
.env
.env.local
.env.*.local
*.key
*.pem
secrets.json

# فایل‌های آرشیو و فشرده‌سازی
# Archive and compressed files
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# فایل‌های پشتیبان و باقی‌مانده از عملیات ویرایش و اعمال تغییرات
# Backup files and temporary files left by editing or patch operations
*.bak
*.backup
*.orig
*.rejbackup.bundle